# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional configurable Gemini model name (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# JWT_SECRET: Secret key for signing authentication tokens on the Express server.
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
